# ThingSpeak channel - lấy từ https://thingspeak.com/channels/<ID>/api_keys
# Dashboard chỉ ĐỌC channel (chỉ ESP32 ghi), nên không cần Write API Key.
CHANNEL_ID=your_channel_id
READ_API_KEY=your_read_api_key

# ThingSpeak TalkBack - Apps → TalkBack → New TalkBack (key riêng, khác key channel)
TALKBACK_ID=your_talkback_id
TALKBACK_API_KEY=your_talkback_api_key

# Server
PORT=3000
